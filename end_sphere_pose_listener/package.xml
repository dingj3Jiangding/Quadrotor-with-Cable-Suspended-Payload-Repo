<?xml version="1.0"?>
<package format="3">
  <name>end_sphere_pose_listener</name>
  <version>0.1.0</version>
  <description>Standalone GZ Transport node to listen to end_sphere pose from Gazebo</description>

  <maintainer email="dingj3@illinois.edu">Your Name</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Needed to compile and link with Gazebo Transport -->
  <depend>gz-transport12</depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>px4_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
