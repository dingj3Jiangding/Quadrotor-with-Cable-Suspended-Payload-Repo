
<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="gazebo_cable">
    <static>false</static>
    
    <!-- Base Link -->
    <link name="cable_base_link">
      <pose>0 0 -0.2 0 0 0</pose>
      <visual name="base_link_visual">
        <geometry>
          <box>
            <size>0.04 0.04 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
      <collision name="base_link_collision">
        <geometry>
          <box>
            <size>0.04 0.04 0.02</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <self_collide>true</self_collide>
    </link>


    <!-- Joint for Previous Cylinder to Sphere -->
    <joint name="segment_1_joint" type="revolute">
      <parent>cable_base_link</parent>
      <child>segment_1_sphere</child>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-3.14</lower>
          <upper>3.14</upper>
          <effort>10</effort>
          <velocity>3</velocity>
        </limit>
      </axis>
      <dynamics>
        <damping>20</damping>
        <friction>1</friction>
      </dynamics>
    </joint>


    <!-- Sphere 1 -->
    <link name="segment_1_sphere">
      <pose>0 0 -0.21000000000000002 0 0 0</pose>
      <visual name="segment_1_sphere_visual">
