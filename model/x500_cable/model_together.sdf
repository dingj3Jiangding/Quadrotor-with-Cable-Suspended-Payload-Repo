          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
      <collision name="segment_30_sphere_collision">
        <geometry><sphere><radius>0.003</radius></sphere></geometry>
      </collision>
      <self_collide>true</self_collide>
    </link>

    <joint name="segment_30_joint" type="revolute">
      <parent>segment_29_cylinder</parent>
      <child>segment_30_sphere</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-3.14</lower><upper>3.14</upper></limit>
        <dynamics><damping>20</damping><friction>1</friction></dynamics></axis>
    </joint>

    <link name="segment_30_cylinder">
      <pose>0 0 -0.278 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="segment_30_cylinder_visual">
        <geometry><cylinder><radius>0.003</radius><length>0.01</length></cylinder></geometry>
        <material>
          <ambient>0 0 0.8 1</ambient>
          <diffuse>0 0 0.8 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
      <collision name="segment_30_collision">
        <geometry><cylinder><radius>0.003</radius><length>0.01</length></cylinder></geometry>
      </collision>
      <self_collide>true</self_collide>
    </link>

    <joint name="segment_30_sphere_to_cylinder" type="revolute">
      <parent>segment_30_sphere</parent>
      <child>segment_30_cylinder</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-3.14</lower><upper>3.14</upper></limit>
        <dynamics><damping>20</damping><friction>1</friction></dynamics></axis>
    </joint>

    <link name="end_sphere">
      <pose>0 0 -0.296 0 0 0</pose>
      <inertial><mass>0.08</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
      <visual name="end_sphere_visual">
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
      </visual>
      <collision name="end_sphere_collision">
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
      </collision>
    </link>

    <joint name="joint_end_sphere" type="revolute">
      <parent>segment_30_cylinder</parent>
      <child>end_sphere</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1.57</lower><upper>1.57</upper></limit></axis>
    </joint>

    <plugin name="gz::sim::systems::OdometryPublisher" filename="libgz-sim-odometry-publisher-system.so">
      <link_name>end_sphere</link_name>
      <topic>/end_sphere/odom</topic>
      <publish_pose>true</publish_pose>
      <publish_velocity>true</publish_velocity>
    </plugin>

  </model>
</sdf>
